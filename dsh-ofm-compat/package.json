{
  "name": "dsh-ofm-compat",
  "version": "0.1.0",
  "type": "module",
  "description": "WeChatAgent 兼容包：把 dsh-our-free-model 的模型自动选择并保活，向 WeChatAgent 暴露一条永不改变的 provider 路由（ofm-auto）+ 固定模型别名（auto）。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "bin": {
    "dsh-ofm-compat": "./scripts/cli.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test test/",
    "selftest": "node scripts/selftest.mjs",
    "doctor": "node scripts/cli.mjs doctor",
    "status": "node scripts/cli.mjs status"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechatagent",
    "our-free-model",
    "llm-provider"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
